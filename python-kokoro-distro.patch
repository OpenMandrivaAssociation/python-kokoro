+class CliTests(unittest.TestCase):
+    def test_help_and_wav(self):
+        import os
+        import subprocess
+        import sys
+
+        env = os.environ.copy()
+        root = Path(__file__).resolve().parents[1]
+        env['PYTHONPATH'] = str(root) + os.pathsep + env.get('PYTHONPATH', '')
+        help_run = subprocess.run(
+            [sys.executable, '-m', 'kokoro', '--help'],
+            env=env,
+            text=True,
+            capture_output=True,
+            check=False,
+        )
+        self.assertEqual(help_run.returncode, 0, help_run.stderr)
+        self.assertIn('<lang code=', help_run.stdout)
+        self.assertIn('<pitch freq=', help_run.stdout)
+        self.assertIn('<pitch note=', help_run.stdout)
+        self.assertIn('Star Trek', help_run.stdout)
+
+        wav = Path('/tmp/kokoro-star-trek.wav')
+        if wav.exists():
+            wav.unlink()
+        run = subprocess.run(
+            [
+                sys.executable, '-m', 'kokoro',
+                '-m', 'thorsten',
+                '-o', str(wav),
+                '-t', 'Der Star mag <lang code="a">Star Trek</lang>.',
+                '--debug',
+            ],
+            env=env,
+            text=True,
+            capture_output=True,
+            check=False,
+        )
+        self.assertEqual(run.returncode, 0, run.stderr)
+        self.assertIn('stˈɑɹ', run.stderr)
+        self.assertIn('ʃ', run.stderr)
+        self.assertNotIn('☃', run.stderr)
+        with wave.open(str(wav), 'rb') as handle:
+            self.assertEqual(handle.getnchannels(), 1)
+            self.assertEqual(handle.getframerate(), 24000)
+            self.assertGreater(handle.getnframes(), 1000)
+        wav.unlink()
