diff -Naur a/kokoro/pitch.py b/kokoro/pitch.py
--- a/kokoro/pitch.py	1970-01-01 01:00:00.000000000 +0100
+++ b/kokoro/pitch.py	2026-11-06 17:55:53.646398066 +0100
@@ -0,0 +1,127 @@
+"""Move a waveform onto requested note frequencies.
+
+Kokoro's decoder only follows its F0 curve inside a voice's speaking
+range. A sung note above that range has to be applied to the waveform.
+Pitch-synchronous overlap-add repeats the voice's own cycles at the new
+period, so the note changes and the formants stay.
+"""
+
+import numpy as np
+
+
+def _at_audio_rate(values, n_samples):
+    values = np.asarray(values)
+    if values.shape[0] == n_samples:
+        return values
+    frames = values.shape[0]
+    if frames and n_samples == frames * 300:
+        return np.repeat(values, 300)
+    if frames == 0:
+        return np.zeros(n_samples, dtype=values.dtype)
+    index = np.minimum((np.arange(n_samples) * frames / n_samples).astype(np.int64), frames - 1)
+    return values[index]
+
+
+def _region(samples, source_hz, target_hz, start, end, sr):
+    n = samples.shape[0]
+    marks = []
+    pos = float(start)
+    while pos < end:
+        f0 = float(source_hz[min(int(pos), n - 1)])
+        if not np.isfinite(f0) or f0 < 40.0:
+            pos += sr / 100.0
+            continue
+        period = max(sr / f0, 1.0)
+        center = int(round(pos))
+        half = max(1, int(round(period / 2.0)))
+        left = max(0, center - half)
+        right = min(n, center + half + 1)
+        if right <= left:
+            pos += period
+            continue
+        peak = left + int(np.argmax(np.abs(samples[left:right])))
+        if not marks or peak - marks[-1] >= half:
+            marks.append(peak)
+        pos += period
+    if len(marks) < 2:
+        return samples[start:end].copy()
+
+    acc = np.zeros(end - start, dtype=np.float64)
+    weight = np.zeros(end - start, dtype=np.float64)
+    syn = float(start)
+    mark_index = 0
+    while syn < end:
+        f_target = float(target_hz[min(int(syn), n - 1)])
+        if not np.isfinite(f_target) or f_target < 40.0:
+            syn += sr / 100.0
+            continue
+        while (
+            mark_index + 1 < len(marks)
+            and abs(marks[mark_index + 1] - syn) <= abs(marks[mark_index] - syn)
+        ):
+            mark_index += 1
+        mark = marks[mark_index]
+        f_source = float(source_hz[min(mark, n - 1)])
+        if not np.isfinite(f_source) or f_source < 40.0:
+            syn += max(sr / f_target, 1.0)
+            continue
+        half = max(2, int(round(sr / f_source)))
+        length = 2 * half
+        window = np.hanning(length)
+        center_out = int(round(syn))
+        src0 = mark - half
+        dst0 = center_out - half
+        src_lo = max(src0, 0)
+        src_hi = min(src0 + length, n)
+        dst_lo = dst0 + (src_lo - src0)
+        dst_hi = dst0 + (src_hi - src0)
+        if dst_lo < start:
+            src_lo += start - dst_lo
+            dst_lo = start
+        if dst_hi > end:
+            src_hi -= dst_hi - end
+            dst_hi = end
+        if src_hi > src_lo:
+            gain = window[src_lo - src0:src_hi - src0]
+            acc[dst_lo - start:dst_hi - start] += samples[src_lo:src_hi] * gain
+            weight[dst_lo - start:dst_hi - start] += gain
+        syn += max(sr / f_target, 1.0)
+
+    shifted = samples[start:end].copy()
+    voiced = weight > 1e-8
+    shifted[voiced] = acc[voiced] / weight[voiced]
+    fade = min(int(sr * 0.005), max(0, (end - start) // 8))
+    if fade > 1:
+        ramp = np.linspace(0.0, 1.0, fade)
+        original = samples[start:end]
+        shifted[:fade] = (1.0 - ramp) * original[:fade] + ramp * shifted[:fade]
+        shifted[-fade:] = ramp * original[-fade:] + (1.0 - ramp) * shifted[-fade:]
+    return shifted
+
+
+def psola(samples, source_hz, target_hz, mask, sr=24000):
+    """Return ``samples`` with masked spans moved from ``source_hz`` to ``target_hz``.
+
+    All three control arrays are either one value per sample or one value
+    per 300-sample F0 frame (Kokoro's fundamental frame). Unmasked samples
+    are copied unchanged.
+    """
+    samples = np.asarray(samples, dtype=np.float64)
+    n = int(samples.shape[0])
+    if n == 0:
+        return samples.copy()
+    source_hz = _at_audio_rate(np.asarray(source_hz, dtype=np.float64), n)
+    target_hz = _at_audio_rate(np.asarray(target_hz, dtype=np.float64), n)
+    mask = _at_audio_rate(np.asarray(mask, dtype=np.float64), n) >= 0.5
+    out = samples.copy()
+    index = 0
+    while index < n:
+        if not mask[index]:
+            index += 1
+            continue
+        end = index + 1
+        while end < n and mask[end]:
+            end += 1
+        out[index:end] = _region(samples, source_hz, target_hz, index, end, sr)
+        index = end
+    return out
diff -Naur a/kokoro/speak.py b/kokoro/speak.py
--- a/kokoro/speak.py	1970-01-01 01:00:00.000000000 +0100
+++ b/kokoro/speak.py	2026-11-06 17:57:31.957416511 +0100
@@ -0,0 +1,727 @@
+"""Speak one text with more than one voice, language, or phoneme string.
+
+``-m`` and ``-l`` are the defaults. Tags in the text change one thing at
+a time:
+
+    <voice name="am_adam">character line</voice>
+    <lang code="a">Star Trek</lang>
+    <phoneme ph="stˈɑɹ tɹˈɛk">Star Trek</phoneme>
+    <pitch note="A4">I</pitch><pitch note="C5">like</pitch><pitch note="F4">dogs</pitch>
+    <pitch freq="450">I</pitch>
+
+A voice tag selects another style pack and, when that voice ships its own
+checkpoint, another model. Thorsten is a checkpoint of its own, not a pack
+for the shared Kokoro model. A language tag does not change the voice. It
+selects that language's spelling rules, so a German sentence can say the
+English title "Star Trek" instead of "Star" the bird (ʃtaːr, "shtar").
+
+A phoneme tag is already the model's symbols. It is not spelled again.
+Symbols outside the active checkpoint's alphabet are replaced with a close
+match or dropped.
+
+A pitch tag holds one note for the words inside it. ``note`` is a letter
+name in equal temperament: A4 is 440 Hz, sharps and flats are written
+C#5 or Bb3, and a missing number means octave 4, so A is A4 and C is
+middle C. ``freq`` is hertz and can sit between those notes. Several
+pitch tags in a row stay one utterance, so the line is sung instead of
+spoken one word at a time. Pitch does not change the voice or the
+language.
+
+Voice, language, and pitch tags nest. ``\\<`` writes a literal ``<``.
+Inside an English span, misaki's ``[word](/phonemes/)`` form still works.
+"""
+
+import math
+import re
+from dataclasses import dataclass, field
+
+from .assets import normalize_lang, require_model, require_voice, voice_meta
+from .phonemes import PITCH_GLIDE, fit_pitched
+
+MAX_PHONEMES = 510
+_G2P_CHUNK = 400
+_TAG_NAMES = {
+    'voice': 'voice',
+    'lang': 'lang',
+    'phoneme': 'phoneme',
+    'phonemes': 'phoneme',
+    'pitch': 'pitch',
+}
+_ALLOWED_ATTRS = {
+    'voice': {'name', 'lang'},
+    'lang': {'code', 'lang'},
+    'phoneme': {'ph'},
+    'pitch': {'freq', 'note'},
+}
+# Scientific pitch. A4 is MIDI 69. Index 0 is C.
+_NOTE_STEPS = {'C': 0, 'D': 2, 'E': 4, 'F': 5, 'G': 7, 'A': 9, 'B': 11}
+_NOTE_NAME = re.compile(r'^([A-G])([#♯b♭])?(-?\d+)?$', re.IGNORECASE)
+_CLOSE_PHONEME = re.compile(r'<\s*/\s*phonemes?\s*>', re.IGNORECASE)
+_TIGHT = frozenset('.,!?;:%)]}"”’')
+_BREAKS = ('.!?', ':;', ',—', ' ')
+
+_pipelines = {}
+
+
+@dataclass
+class Span:
+    text: str
+    voice: str
+    lang: str
+    raw: bool
+    freq: object = None
+
+
+@dataclass
+class Frame:
+    kind: str
+    voice: str
+    lang: str
+    freq: object = None
+
+
+@dataclass
+class VoiceInfo:
+    name: str
+    path: object
+    language: str
+    model: str
+
+
+@dataclass
+class Utterance:
+    """One synthesis call: one pack, one checkpoint, one phoneme string."""
+
+    voice: str
+    path: object
+    model: str
+    phonemes: str
+    graphemes: str
+    # One entry per phoneme character: hertz, PITCH_GLIDE, or None.
+    pitches: object = None
+
+
+def resolve_voice(name):
+    path = require_voice(name)
+    meta = voice_meta(path)
+    language = meta.get('language') or path.stem[:1]
+    language = normalize_lang(language)
+    model = str(meta.get('model') or 'kokoro-v1_0')
+    return VoiceInfo(name=path.stem, path=path, language=language, model=model)
+
+
+def _parse_attrs(body, allowed):
+    attrs = {}
+    i = 0
+    size = len(body)
+    while i < size:
+        while i < size and body[i].isspace():
+            i += 1
+        if i >= size:
+            break
+        start = i
+        while i < size and (body[i].isalnum() or body[i] in ':-_'):
+            i += 1
+        key = body[start:i].lower()
+        if not key:
+            raise SystemExit(f'Bad attribute in tag: {body!r}')
+        while i < size and body[i].isspace():
+            i += 1
+        if i >= size or body[i] != '=':
+            raise SystemExit(f'Attribute {key!r} needs a quoted value.')
+        i += 1
+        while i < size and body[i].isspace():
+            i += 1
+        if i >= size or body[i] not in '"\'':
+            raise SystemExit(f'Attribute {key!r} needs a quoted value.')
+        quote = body[i]
+        i += 1
+        start = i
+        while i < size and body[i] != quote:
