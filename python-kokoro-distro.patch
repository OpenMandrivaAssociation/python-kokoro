+    while j < size and text[j].isalpha():
+        j += 1
+    raw = text[start:j].lower()
+    if raw not in _TAG_NAMES:
+        return None
+    name = _TAG_NAMES[raw]
+    buf = []
+    self_closing = False
+    while j < size:
+        ch = text[j]
+        if ch in '"\'':
+            endq = text.find(ch, j + 1)
+            if endq < 0:
+                raise SystemExit('Unclosed quote in a tag.')
+            buf.append(text[j:endq + 1])
+            j = endq + 1
+            continue
+        if ch == '>':
+            body = ''.join(buf).rstrip()
+            if body.endswith('/'):
+                self_closing = True
+                body = body[:-1].rstrip()
+            attrs = _parse_attrs(body, _ALLOWED_ATTRS[name])
+            return j + 1, closing, name, attrs, self_closing
+        buf.append(ch)
+        j += 1
+    raise SystemExit('Unclosed tag: missing ">".')
+
+
+def parse_markup(text, voice, lang):
+    """Split ``text`` into spans. ``voice`` and ``lang`` are the defaults.
+
+    Language codes are normalized. Voices are not looked up yet.
+    """
+    lang = normalize_lang(lang)
+    spans = []
+    stack = [Frame('root', voice, lang)]
+    buf = []
+    i = 0
+    size = len(text)
+
+    def flush():
+        if not buf:
+            return
+        chunk = ''.join(buf)
+        buf.clear()
+        if not chunk.strip():
+            return
+        cur = stack[-1]
+        spans.append(Span(chunk, cur.voice, cur.lang, cur.kind == 'phoneme', cur.freq))
+
+    while i < size:
+        if text[i] == '\\' and i + 1 < size and text[i + 1] == '<':
+            buf.append('<')
+            i += 2
+            continue
+        if text[i] != '<':
+            buf.append(text[i])
+            i += 1
+            continue
+        # A phoneme body is literal, including anything that looks like a tag,
+        # until its own closing tag.
+        if stack[-1].kind == 'phoneme':
+            close = _CLOSE_PHONEME.search(text, i)
+            if close is None:
+                raise SystemExit('Unclosed <phoneme> tag.')
+            buf.append(text[i:close.start()])
+            flush()
+            stack.pop()
+            i = close.end()
+            continue
+        tag = _read_tag(text, i)
+        if tag is None:
+            buf.append(text[i])
+            i += 1
+            continue
+        end, closing, name, attrs, self_closing = tag
+        flush()
+        i = end
+        if name == 'phoneme' and not closing:
+            ph = attrs.get('ph')
+            if ph is not None:
+                if ph.strip():
+                    cur = stack[-1]
+                    spans.append(Span(ph.strip(), cur.voice, cur.lang, True, cur.freq))
+                if not self_closing:
+                    close = _CLOSE_PHONEME.search(text, i)
+                    if close is None:
+                        raise SystemExit('Unclosed <phoneme> tag.')
+                    i = close.end()
+                continue
+            if self_closing:
+                continue
+            cur = stack[-1]
+            stack.append(Frame('phoneme', cur.voice, cur.lang, cur.freq))
+            continue
+        if closing:
+            if len(stack) == 1 or stack[-1].kind != name:
+                opened = stack[-1].kind
+                raise SystemExit(f'</{name}> does not match the open <{opened}> tag.')
+            stack.pop()
+            continue
+        if name == 'voice':
+            vname = attrs.get('name')
+            if not vname or not vname.strip():
+                raise SystemExit('A voice tag needs a name: <voice name="am_adam">.')
+            vlang = stack[-1].lang
+            if attrs.get('lang'):
+                vlang = normalize_lang(attrs['lang'])
+            if not self_closing:
+                stack.append(Frame('voice', vname.strip(), vlang, stack[-1].freq))
+            continue
+        if name == 'pitch':
+            freq = _pitch_attr(attrs)
+            if not self_closing:
+                cur = stack[-1]
+                stack.append(Frame('pitch', cur.voice, cur.lang, freq))
+            continue
+        code = attrs.get('code', attrs.get('lang'))
+        if not code or not str(code).strip():
+            raise SystemExit('A language tag needs a code: <lang code="a">.')
+        if not self_closing:
+            cur = stack[-1]
+            stack.append(Frame('lang', cur.voice, normalize_lang(code), cur.freq))
+    flush()
+    if len(stack) != 1:
+        raise SystemExit(f'Unclosed <{stack[-1].kind}> tag.')
+    return spans
+
+
+def _parse_freq(raw):
+    text = '' if raw is None else str(raw).strip()
+    try:
+        freq = float(text)
+    except ValueError:
+        freq = None
+    if freq is None or not math.isfinite(freq) or freq <= 0:
+        raise SystemExit(
+            f'Pitch frequency must be a positive number of hertz, not {raw!r}.'
+        )
+    return freq
+
+
+def _parse_note(raw):
+    """Equal temperament. A4 is 440 Hz. A missing octave means 4."""
+    text = '' if raw is None else str(raw).strip()
+    match = _NOTE_NAME.fullmatch(text)
+    if match is None:
+        raise SystemExit(
+            f'Pitch note must look like A4, C#5, or Bb3, not {raw!r}. '
+            'Use freq for a frequency in hertz.'
+        )
+    step = _NOTE_STEPS[match.group(1).upper()]
+    accidental = match.group(2)
+    if accidental in ('#', '♯'):
+        step += 1
+    elif accidental:
+        step -= 1
+    if match.group(3) is None:
+        octave = 4
+    else:
+        octave = int(match.group(3))
+        if octave < -1 or octave > 8:
+            raise SystemExit(f'Pitch note {raw!r} is outside octave -1 to 8.')
+    # C4 is MIDI 60, so octave 4 and step 0 land on 60. A4 is 69.
+    midi = (octave + 1) * 12 + step
+    return 440.0 * 2.0 ** ((midi - 69) / 12.0)
+
+
+def _pitch_attr(attrs):
+    has_freq = 'freq' in attrs
+    has_note = 'note' in attrs
+    if has_freq and has_note:
+        raise SystemExit('Use either freq or note on a pitch tag, not both.')
+    if has_freq:
+        return _parse_freq(attrs['freq'])
+    if has_note:
+        return _parse_note(attrs['note'])
+    raise SystemExit('A pitch tag needs freq="440" or note="A4".')
+
+
+def _as_hz(value):
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return None
+    value = float(value)
+    if not math.isfinite(value) or value <= 0:
+        return None
+    return value
+
+
+def join_pieces(pieces):
+    """Join phoneme fragments. Tight punctuation stays on the previous word."""
+    out = ''
+    for piece in pieces:
+        piece = (piece or '').strip()
+        if not piece:
+            continue
+        if not out:
+            out = piece
+        elif piece[0] in _TIGHT:
+            out += piece
+        else:
+            out += ' ' + piece
+    return out
+
+
+def join_pitched(pieces):
+    """Join ``(phonemes, freq)`` pieces and record a pitch per character.
+
+    ``freq`` is a frequency in hertz, or None. A space inserted between
+    two notes is :data:`PITCH_GLIDE`. Any other inserted space keeps the
+    model's pitch. Tight punctuation stays on the previous piece.
+    """
+    chars = []
+    hz = []
+    for phonemes, freq in pieces:
+        phonemes = (phonemes or '').strip()
+        if not phonemes:
+            continue
+        if chars and phonemes[0] not in _TIGHT:
+            gap = PITCH_GLIDE if _as_hz(hz[-1]) is not None and _as_hz(freq) is not None else None
+            chars.append(' ')
+            hz.append(gap)
+        for _ch in phonemes:
+            chars.append(_ch)
+            hz.append(freq)
+    return ''.join(chars), hz
+
+
+def _aligned_strip(text, pitches):
+    start = 0
+    end = len(text)
+    while start < end and text[start].isspace():
+        start += 1
+    while end > start and text[end - 1].isspace():
+        end -= 1
+    if pitches is None:
+        return text[start:end], None
+    return text[start:end], pitches[start:end]
+
+
+def _one_freq(values):
+    chosen = None
+    for value in values:
+        if value is None:
+            continue
+        if chosen is None:
+            chosen = value
+            continue
+        if value != chosen:
+            return None
+    return chosen
+
+
+def _normalize_phonemes(phonemes, pitches):
+    phonemes = phonemes or ''
+    if pitches is not None and len(pitches) != len(phonemes):
+        pitches = None
+    if pitches is None:
+        return re.sub(r'\s+', ' ', phonemes).strip(), None
+    chars = []
+    hz = []
+    index = 0
+    size = len(phonemes)
+    while index < size:
+        if phonemes[index].isspace():
+            end = index + 1
+            while end < size and phonemes[end].isspace():
+                end += 1
+            chars.append(' ')
+            hz.append(_one_freq(pitches[index:end]))
+            index = end
+            continue
+        chars.append(phonemes[index])
+        hz.append(pitches[index])
+        index += 1
+    return _aligned_strip(''.join(chars), hz)
+
+
+def _cut_phonemes(phonemes, limit):
+    window = phonemes[:limit]
+    cut = 0
+    for group in _BREAKS:
+        at = max(window.rfind(ch) for ch in group)
+        if at > 0:
+            cut = at + 1
+            break
+    if cut <= 0:
+        cut = limit
+    return cut
+
+
+def chunk_pitched(phonemes, pitches=None, limit=MAX_PHONEMES):
+    """Like :func:`chunk_phonemes`, keeping a pitch list beside the text."""
+    phonemes, pitches = _normalize_phonemes(phonemes, pitches)
+    if not phonemes:
+        return []
+    chunks = []
+    while len(phonemes) > limit:
+        cut = _cut_phonemes(phonemes, limit)
+        left_hz = None if pitches is None else pitches[:cut]
+        right_hz = None if pitches is None else pitches[cut:]
+        piece, piece_hz = _aligned_strip(phonemes[:cut], left_hz)
+        rest, rest_hz = _aligned_strip(phonemes[cut:], right_hz)
+        if not piece:
+            left_hz = None if pitches is None else pitches[:limit]
+            right_hz = None if pitches is None else pitches[limit:]
+            piece, piece_hz = _aligned_strip(phonemes[:limit], left_hz)
+            rest, rest_hz = _aligned_strip(phonemes[limit:], right_hz)
+        if piece:
+            chunks.append((piece, piece_hz))
+        if not rest or rest == phonemes:
+            phonemes = ''
+            pitches = None
+            break
+        phonemes, pitches = rest, rest_hz
+    if phonemes:
+        chunks.append((phonemes, pitches))
+    return chunks
+
+
+def chunk_phonemes(phonemes, limit=MAX_PHONEMES):
+    """Split a phoneme string into chunks the model can speak.
+
+    Prefer a sentence end, then a pause, then a space, and only then a
+    hard cut. Chunks are at most ``limit`` symbols.
+    """
+    return [piece for piece, _hz in chunk_pitched(phonemes, None, limit)]
+
+
+def _pitches_for(hz):
+    if not hz or all(item is None for item in hz):
+        return None
+    return tuple(hz)
+
+
+def _split_for_g2p(text, lang):
+    text = text.strip()
+    if not text:
+        return []
+    # English misaki keeps context across the paragraph. espeak-ng can
+    # truncate a long argument, so other languages are cut on sentences
+    # the same way KPipeline cuts them.
+    if lang in 'ab' or len(text) <= _G2P_CHUNK:
+        return [text]
+    chunks = []
+    sentences = re.split(r'([.!?]+)', text)
+    current = ''
+    for index in range(0, len(sentences), 2):
+        sentence = sentences[index]
+        if index + 1 < len(sentences):
+            sentence += sentences[index + 1]
+        if current and len(current) + len(sentence) > _G2P_CHUNK:
+            chunks.append(current.strip())
+            current = sentence
+        else:
+            current += sentence
+    if current.strip():
+        chunks.append(current.strip())
+    if not chunks:
+        chunks = [text[i:i + _G2P_CHUNK] for i in range(0, len(text), _G2P_CHUNK)]
+    return [chunk for chunk in chunks if chunk.strip()]
+
+
+def get_pipeline(lang):
+    """Quiet pipeline: spelling rules only, no checkpoint."""
+    lang = normalize_lang(lang)
+    pipe = _pipelines.get(lang)
+    if pipe is None:
+        from .pipeline import KPipeline
+        try:
+            pipe = KPipeline(lang_code=lang, repo_id='hexgrad/Kokoro-82M', model=False)
+        except ImportError as exc:
+            raise SystemExit(
+                f'Language {lang!r} needs grapheme-to-phoneme support that is not installed.'
+            ) from exc
+        _pipelines[lang] = pipe
+    return pipe
+
+
+def phonemize(lang, text):
+    lang = normalize_lang(lang)
+    g2p = get_pipeline(lang).g2p
+    parts = []
+    for chunk in _split_for_g2p(text, lang):
+        ps, _tokens = g2p(chunk)
+        if ps and ps.strip():
+            parts.append(ps.strip())
+    return join_pieces(parts)
+
+
+def _load_vocab(model_name):
+    import json
+    config, _weights = require_model(model_name)
+    with open(config, encoding='utf-8') as handle:
+        return json.load(handle)['vocab']
+
+
+def plan_utterances(
+    text,
+    voice,
+    lang,
+    model=None,
+    resolve=None,
+    phonemize_fn=None,
+    vocab_for=None,
+):
+    """Turn tagged text into synthesis calls.
+
+    Spans that share a pack and a checkpoint are one phoneme string, so a
+    language change or a new note inside a sentence keeps one prosody. A
+    different pack, or a newline, starts a new call. ``model``, when set,
+    overrides the checkpoint of the default voice only.
+    """
+    resolve = resolve or resolve_voice
+    phonemize_fn = phonemize_fn or phonemize
+    spans = parse_markup(text, voice, lang)
+    infos = {}
+    for span in spans:
+        if span.voice not in infos:
+            infos[span.voice] = resolve(span.voice)
+    vocabs = {}
+
+    def vocab_of(model_name):
+        if model_name not in vocabs:
+            if vocab_for is not None:
+                vocabs[model_name] = vocab_for(model_name)
+            else:
+                vocabs[model_name] = _load_vocab(model_name)
+        return vocabs[model_name]
+
+    @dataclass
+    class _Acc:
+        key: object = None
+        info: object = None
+        model_name: object = None
+        pieces: list = field(default_factory=list)
+        graphs: list = field(default_factory=list)
+
+    acc = _Acc()
+    utterances = []
+
+    def flush():
+        if not acc.pieces:
+            acc.graphs.clear()
+            return
+        phones, hz = join_pitched(acc.pieces)
+        ps, hz = fit_pitched(phones, hz, vocab_of(acc.model_name))
+        graph = ''.join(acc.graphs).strip()
+        for chunk, chunk_hz in chunk_pitched(ps, hz):
+            utterances.append(Utterance(
+                voice=acc.info.name,
+                path=acc.info.path,
+                model=acc.model_name,
+                phonemes=chunk,
+                graphemes=graph,
+                pitches=_pitches_for(chunk_hz),
+            ))
+        acc.pieces.clear()
+        acc.graphs.clear()
+
+    def add(info, model_name, phone, graph, freq):
+        key = (str(info.path), model_name)
+        if acc.key != key:
+            flush()
+            acc.key = key
+            acc.info = info
+            acc.model_name = model_name
+        phone = (phone or '').strip()
+        if not phone:
+            return
+        acc.pieces.append((phone, freq))
+        acc.graphs.append(graph)
+
+    for span in spans:
+        info = infos[span.voice]
+        model_name = info.model
+        if model and span.voice == voice:
+            model_name = model
+        parts = re.split(r'\n+', span.text)
+        for index, part in enumerate(parts):
+            if index:
+                flush()
+            if not part.strip():
+                continue
+            phone = part if span.raw else phonemize_fn(span.lang, part)
+            add(info, model_name, phone, part, span.freq)
+    flush()
+    return utterances
+
+
+def prepare_speech(text, voice='af_heart', lang=None, model=None):
+    """Parse and phonemize. Load no checkpoint weights."""
+    text = '' if text is None else str(text).strip()
+    if lang is None:
+        lang = resolve_voice(voice).language
+    else:
+        lang = normalize_lang(lang)
+    if not text:
+        resolve_voice(voice)
+        return []
+    return plan_utterances(text, voice=voice, lang=lang, model=model)
+
+
+def open_models(utterances):
+    """Load each checkpoint named by ``utterances`` once."""
+    import torch
+    from .model import KModel
+
+    device = 'cuda' if torch.cuda.is_available() else 'cpu'
+    models = {}
+    for utterance in utterances:
+        if utterance.model in models:
+            continue
+        config, weights = require_model(utterance.model)
+        models[utterance.model] = KModel(
+            repo_id='hexgrad/Kokoro-82M',
+            config=str(config),
+            model=str(weights),
+        ).to(device).eval()
+    return models
+
+
+def _holder():
+    if _pipelines:
+        return next(iter(_pipelines.values()))
+    return get_pipeline('a')
+
+
+def iter_audio(utterances, models, speed=1.0):
+    """Speak planned utterances. Packs are loaded by the pipeline."""
+    if not utterances:
+        return
+    holder = _holder()
+    for utterance in utterances:
+        if not utterance.phonemes:
+            continue
+        kmodel = models[utterance.model]
+        for result in holder.generate_from_tokens(
+            utterance.phonemes,
+            voice=str(utterance.path),
+            speed=speed,
+            model=kmodel,
+            pitches=utterance.pitches,
+        ):
+            if utterance.graphemes:
+                result.graphemes = utterance.graphemes
+            yield result
+
+
+def speak(text, voice='af_heart', lang=None, speed=1.0, model=None):
+    """Yield audio results for ``text``.
+
+    Voice, language, phoneme, and pitch tags are honored.
+    """
+    utterances = prepare_speech(text, voice=voice, lang=lang, model=model)
+    if not utterances:
+        return
+    models = open_models(utterances)
+    yield from iter_audio(utterances, models, speed)
