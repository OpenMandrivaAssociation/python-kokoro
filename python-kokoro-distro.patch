+# istftnet.SourceModuleHnNSF uses voiced_threshod=10: an F0 at or below
+# this is unvoiced noise, not a sine. Kokoro's curve is in hertz.
+_UNVOICED_HZ = 10.0
+
+
+def _pitch_hz(value):
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return None
+    value = float(value)
+    if not math.isfinite(value) or value <= 0:
+        return None
+    return value
+
+
+def impose_pitch(f0, pred_dur, pitches, unvoiced_hz=_UNVOICED_HZ):
+    """Replace voiced F0 frames with the requested notes.
+
+    ``pitches`` lines up with the phoneme characters. ``pred_dur`` is one
+    longer on each side (start and end padding). The F0 curve has two
+    frames per duration step: the prosody predictor upsamples once by 2.
+    Padding and any frame the model left unvoiced keep the prediction, so
+    a rest does not turn into a buzz. A glide marker interpolates, in
+    log frequency, between the notes on either side.
+    """
+    if not pitches:
+        return f0
+    durs = [int(item) for item in pred_dur.detach().reshape(-1).tolist()]
+    if len(durs) != len(pitches) + 2:
+        logger.debug(f'pitch ignored: {len(durs)} durations for {len(pitches)} symbols')
+        return f0
+    total = sum(durs)
+    flat = f0.detach().reshape(-1)
+    if flat.numel() != 2 * total:
+        logger.debug(f'pitch ignored: F0 length {flat.numel()} is not {2 * total}')
+        return f0
+    original = flat.tolist()
+    marks = [None] * len(durs)
+    for index, value in enumerate(pitches):
+        hz = _pitch_hz(value)
+        if hz is not None:
+            marks[index + 1] = hz
+        elif value == PITCH_GLIDE:
+            marks[index + 1] = PITCH_GLIDE
+    desired = [None] * (2 * total)
+    cursor = 0
+    spans = []
+    for mark, dur in zip(marks, durs):
+        width = 2 * dur
+        spans.append((cursor, cursor + width))
+        if isinstance(mark, float):
+            for frame in range(cursor, cursor + width):
+                if original[frame] > unvoiced_hz:
+                    desired[frame] = mark
+        cursor += width
+
+    def neighbor(index, step):
+        cursor_index = index + step
+        while 0 <= cursor_index < len(marks):
+            mark = marks[cursor_index]
+            if isinstance(mark, float):
+                return mark
+            if mark != PITCH_GLIDE:
+                return None
+            cursor_index += step
+        return None
+
+    for index, mark in enumerate(marks):
+        if mark != PITCH_GLIDE:
+            continue
+        left = neighbor(index, -1)
+        right = neighbor(index, 1)
+        if left is None or right is None or left <= 0 or right <= 0:
+            continue
+        start, end = spans[index]
+        span = end - start
+        if span <= 0:
+            continue
+        for offset, frame in enumerate(range(start, end)):
+            if original[frame] <= unvoiced_hz:
+                continue
+            if left == right:
+                desired[frame] = left
+                continue
+            frac = (offset + 1) / (span + 1)
+            desired[frame] = math.exp(math.log(left) * (1.0 - frac) + math.log(right) * frac)
+
+    if all(item is None for item in desired):
+        return f0
+    out = f0.clone()
+    view = out.reshape(-1)
+    for frame, hz in enumerate(desired):
+        if hz is not None:
+            view[frame] = hz
+    return out
+
+
+def sing(audio, f0, pred_dur, pitches):
+    """Move ``audio`` onto the notes in ``pitches``.
+
+    ``f0`` is the speaking contour the decoder just used. Frames that
+    :func:`impose_pitch` would replace are resynthesized at that note.
+    Everything else, including the start and end padding, is left as spoken.
+    """
+    target = impose_pitch(f0, pred_dur, pitches)
+    if target is f0:
+        return audio
+    source = f0.detach().reshape(-1).float()
+    desired = target.detach().reshape(-1).float()
+    if source.shape != desired.shape:
+        return audio
+    mask = (desired - source).abs() > 1.0
+    if not bool(mask.any()):
+        return audio
+    shifted = psola(
+        audio.detach().reshape(-1).float().cpu().numpy(),
+        source.cpu().numpy(),
+        desired.cpu().numpy(),
+        mask.cpu().numpy(),
+    )
+    out = torch.from_numpy(np.ascontiguousarray(shifted, dtype=np.float32))
+    out = out.to(device=audio.device, dtype=audio.dtype).clone()
+    return out.reshape(audio.shape)
