+def voice_file(name: str) -> Path:
+    path = Path(name)
+    if path.suffix == ".pt" or path.is_file():
+        return path
+    return SHARE / "voices" / f"{name}.pt"
+
+
+def voice_meta(path: Path) -> dict:
+    meta_path = path.with_suffix(".json")
+    if not meta_path.is_file():
+        return {}
+    with meta_path.open(encoding="utf-8") as handle:
+        data = json.load(handle)
+    if not isinstance(data, dict):
+        raise SystemExit(f"{meta_path} is not a JSON object")
+    return data
+
+
+def installed_voices():
+    directory = SHARE / "voices"
+    if not directory.is_dir():
+        return []
+    rows = []
+    for path in sorted(directory.glob("*.pt")):
+        meta = voice_meta(path)
+        language = meta.get("language") or (path.stem[:1])
+        model = meta.get("model") or DEFAULT_MODEL
+        rows.append((path.stem, str(language), str(model)))
+    return rows
+
+
+def list_voices() -> None:
+    rows = installed_voices()
+    if not rows:
+        print(f"No voices installed under {SHARE / 'voices'}", file=sys.stderr)
+        print("Install kokoro-voices or kokoro-voice-thorsten.", file=sys.stderr)
+        raise SystemExit(1)
+    for name, language, model in rows:
+        print(f"{name}\tlanguage={language}\tmodel={model}")
+
+
+def model_files(model_name: str):
+    directory = SHARE / "models" / model_name
+    config = directory / "config.json"
+    weights = None
+    for candidate in (directory / f"{model_name}.pth", directory / "model.pth"):
+        if candidate.is_file():
+            weights = candidate
+            break
+    return config, weights
+
+
+def require_voice(name: str) -> Path:
+    path = voice_file(name)
+    if path.is_file():
+        return path
+    stem = Path(name).stem
+    package = "kokoro-voice-thorsten" if stem == "thorsten" else VOICE_PACKAGES.get(stem[:1], "kokoro-voices")
+    installed = ", ".join(row[0] for row in installed_voices()) or "(none)"
+    raise SystemExit(
+        f"Voice {name!r} is not installed ({path}).\n"
+        f"Install {package}.\n"
+        f"Installed voices: {installed}"
+    )
+
+
+def require_model(model_name: str):
+    config, weights = model_files(model_name)
+    if config.is_file() and weights is not None:
+        return config, weights
+    package = MODEL_PACKAGES.get(model_name, "kokoro-model")
+    raise SystemExit(
+        f"Kokoro model {model_name!r} is not installed under {SHARE / 'models' / model_name}.\n"
+        f"Install {package}."
+    )
 
 
