+"""Local Kokoro voices and checkpoints under /usr/share/kokoro.
+
+Nothing is downloaded. A missing voice or checkpoint is an error that
+names the package which provides it.
+"""
+
+import json
+import os
+from pathlib import Path
+
+LANGUAGES = (
+    'a',  # American English
+    'b',  # British English
+    'd',  # German
+    'h',  # Hindi
+    'e',  # Spanish
+    'f',  # French
+    'i',  # Italian
+    'p',  # Brazilian Portuguese
+    'j',  # Japanese
+    'z',  # Mandarin Chinese
+)
+
+# Short names and locale tags accepted by -l and by <lang code="...">.
+# Single-letter codes match KPipeline.
+LANG_ALIASES = {
+    'en': 'a',
+    'en-us': 'a',
+    'en-gb': 'b',
+    'de': 'd',
+    'de-de': 'd',
+    'es': 'e',
+    'es-es': 'e',
+    'fr': 'f',
+    'fr-fr': 'f',
+    'hi': 'h',
+    'it': 'i',
+    'pt': 'p',
+    'pt-br': 'p',
+    'ja': 'j',
+    'zh': 'z',
+    'cmn': 'z',
+}
+
+DEFAULT_MODEL = 'kokoro-v1_0'
+
+MODEL_PACKAGES = {
+    'kokoro-v1_0': 'kokoro-model',
+    'kokoro-v1_1-zh': 'kokoro-model',
+    'thorsten': 'kokoro-voice-thorsten',
+}
+
+
+def share_dir():
+    return Path(os.environ.get('KOKORO_SHARE', '/usr/share/kokoro'))
+
+
+def normalize_lang(code):
+    """Return the single-letter language code, or exit if it is unknown."""
+    if code is None or str(code).strip() == '':
+        raise SystemExit(
+            'Missing language code. '
+            f"Use one of: {' '.join(LANGUAGES)}"
+        )
+    key = str(code).strip().lower().replace('_', '-')
+    key = LANG_ALIASES.get(key, key)
+    if key not in LANGUAGES:
+        raise SystemExit(
+            f"Unknown language {code!r}. "
+            f"Use one of: {' '.join(LANGUAGES)} "
+            '(or en, en-us, en-gb, de, es, fr, hi, it, pt, ja, zh).'
+        )
+    return key
+
+
+def voice_file(name):
+    path = Path(name)
+    if path.suffix == '.pt' or path.is_file():
+        return path
+    return share_dir() / 'voices' / f'{name}.pt'
+
+
+def voice_meta(path):
+    meta_path = Path(path).with_suffix('.json')
+    if not meta_path.is_file():
+        return {}
+    with meta_path.open(encoding='utf-8') as handle:
+        data = json.load(handle)
+    if not isinstance(data, dict):
+        raise SystemExit(f'{meta_path} is not a JSON object')
+    return data
+
+
+def installed_voices():
+    directory = share_dir() / 'voices'
+    if not directory.is_dir():
+        return []
+    rows = []
+    for path in sorted(directory.glob('*.pt')):
+        meta = voice_meta(path)
+        language = meta.get('language') or path.stem[:1]
+        model = meta.get('model') or DEFAULT_MODEL
+        rows.append((path.stem, str(language), str(model)))
+    return rows
+
+
+def model_files(model_name):
+    directory = share_dir() / 'models' / model_name
+    config = directory / 'config.json'
+    weights = None
+    for candidate in (directory / f'{model_name}.pth', directory / 'model.pth'):
+        if candidate.is_file():
+            weights = candidate
+            break
+    return config, weights
+
+
+def require_voice(name):
+    path = voice_file(name)
+    if path.is_file():
+        return path
+    stem = Path(name).stem
+    package = f'kokoro-voice-{stem}'
+    installed = ', '.join(row[0] for row in installed_voices()) or '(none)'
+    raise SystemExit(
+        f"Voice {name!r} is not installed ({path}).\n"
+        f'Install {package}.\n'
+        f'Installed voices: {installed}'
+    )
+
+
+def require_model(model_name):
+    config, weights = model_files(model_name)
+    if config.is_file() and weights is not None:
+        return config, weights
+    package = MODEL_PACKAGES.get(model_name, 'kokoro-model')
+    raise SystemExit(
+        f"Kokoro model {model_name!r} is not installed under {share_dir() / 'models' / model_name}.\n"
+        f'Install {package}.'
+    )
