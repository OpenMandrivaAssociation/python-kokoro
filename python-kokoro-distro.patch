+    def test_psola_moves_a_vowel_onto_the_note(self):
+        import numpy as np
+
+        sr = 24000
+        seconds = 0.4
+        n = int(sr * seconds)
+        time = np.arange(n) / sr
+        source = 150.0
+        wave = np.zeros(n)
+        for harmonic in range(1, 12):
+            wave += np.sin(2 * np.pi * harmonic * source * time) / harmonic
+        spoken = wave.copy()
+        spoken[:1000] += 0.2 * np.sin(2 * np.pi * 90 * time[:1000])
+        for target in (349.23, 440.0, 523.5):
+            mask = np.zeros(n)
+            mask[1000:] = 1.0
+            sung = psola(
+                spoken,
+                np.full(n, source),
+                np.full(n, target),
+                mask,
+                sr=sr,
+            )
+            self.assertEqual(sung.shape, spoken.shape)
+            self.assertTrue(np.array_equal(sung[:1000], spoken[:1000]))
+            peak = _spectral_peak(sung[2000:], sr)
+            self.assertLess(
+                abs(peak - target) / target,
+                0.04,
+                f'{peak:.1f} Hz is not {target} Hz',
+            )
+            original_peak = _spectral_peak(spoken[2000:], sr)
+            self.assertLess(abs(original_peak - source) / source, 0.04)
+
+
+def _spectral_peak(audio, sr=24000, low=70.0, high=1000.0):
+    """Frequency of the strongest spectral peak, in hertz."""
+    import numpy as np
+
+    samples = np.asarray(audio, dtype=np.float64)
+    if samples.size < 64:
+        return None
+    samples = samples - samples.mean()
+    window = np.hanning(samples.size)
+    spectrum = np.abs(np.fft.rfft(samples * window))
+    freqs = np.fft.rfftfreq(samples.size, 1.0 / sr)
+    band = np.where((freqs >= low) & (freqs <= high))[0]
+    if band.size == 0:
+        return None
+    local = int(band[np.argmax(spectrum[band])])
+    if 0 < local < spectrum.size - 1:
+        left, mid, right = spectrum[local - 1], spectrum[local], spectrum[local + 1]
+        denom = left - 2.0 * mid + right
+        if denom:
+            shift = 0.5 * (left - right) / denom
+            if abs(shift) < 1.0:
+                return float(freqs[local] + shift * (freqs[1] - freqs[0]))
+    return float(freqs[local])
+
+
+class AudioTests(unittest.TestCase):
+    def test_mixed_sentence_writes_audio(self):
+        from kokoro.speak import speak
+
+        results = list(speak(
+            'Der Star mag <lang code="a">Star Trek</lang>.',
+            voice='thorsten',
+            lang='d',
+        ))
+        self.assertTrue(results)
+        audio = results[0].audio
+        self.assertIsNotNone(audio)
+        self.assertGreater(audio.numel(), 1000)
+        self.assertGreater(float(audio.abs().mean()), 0.0)
+        self.assertIn('stˈɑɹ', results[0].phonemes)
+        self.assertIn('ʃ', results[0].phonemes)
+        # What the checkpoint received is in its alphabet.
+        self.assertTrue(all(ch in VOCAB for ch in results[0].phonemes))
+
+    def test_two_packs_on_one_checkpoint(self):
+        import os
+        import tempfile
+
+        from kokoro.speak import speak
+
+        src = Path('/usr/share/kokoro')
+        tmp = Path(tempfile.mkdtemp())
+        (tmp / 'models').symlink_to(src / 'models')
+        voices = tmp / 'voices'
+        voices.mkdir()
+        for name in ('narrator', 'hero'):
+            (voices / f'{name}.pt').symlink_to(src / 'voices' / 'thorsten.pt')
+            (voices / f'{name}.json').write_text(
+                '{"language": "d", "model": "thorsten"}\n',
+                encoding='utf-8',
+            )
+        import shutil
+        old = os.environ.get('KOKORO_SHARE')
+        os.environ['KOKORO_SHARE'] = str(tmp)
+        try:
+            results = list(speak(
+                '<voice name="narrator">Der Star sang.</voice>'
+                '<voice name="hero" lang="a">Star Trek.</voice>',
+                voice='narrator',
+                lang='d',
+            ))
+        finally:
+            if old is None:
+                os.environ.pop('KOKORO_SHARE', None)
+            else:
+                os.environ['KOKORO_SHARE'] = old
+            shutil.rmtree(tmp, ignore_errors=True)
+        self.assertEqual(len(results), 2)
+        self.assertGreater(results[0].audio.numel(), 1000)
+        self.assertGreater(results[1].audio.numel(), 1000)
+        self.assertIn('ʃ', results[0].phonemes)
+        self.assertNotIn('stˈɑɹ', results[0].phonemes)
+        self.assertIn('stˈɑɹ', results[1].phonemes)
+        self.assertTrue(all(ch in VOCAB for ch in results[0].phonemes + results[1].phonemes))
+
+    def test_pitch_tags_sing_the_given_notes(self):
+        from kokoro.speak import iter_audio, open_models
+
+        text = (
+            '<pitch freq="440">I</pitch>'
+            '<pitch freq="523.5">like</pitch>'
+            '<pitch freq="349.23">dogs</pitch>'
+        )
+        utterances = prepare_speech(text, voice='thorsten', lang='a')
+        self.assertEqual(len(utterances), 1)
+        pitches = utterances[0].pitches
+        self.assertEqual(len(pitches), len(utterances[0].phonemes))
+        targets = []
+        for value in pitches:
+            if not isinstance(value, float):
+                continue
+            if not targets or targets[-1] != value:
+                targets.append(value)
+        self.assertEqual(targets, [440.0, 523.5, 349.23])
+        results = list(iter_audio(utterances, open_models(utterances)))
+        self.assertEqual(len(results), 1)
+        audio = results[0].audio
+        self.assertGreater(audio.numel(), 1000)
+        durations = [int(item) for item in results[0].output.pred_dur.tolist()]
+        self.assertEqual(len(durations), len(pitches) + 2)
+        self.assertEqual(audio.numel(), 600 * sum(durations))
+        samples = audio.numpy()
+        estimates = []
+        group_hz = None
+        group = []
+
+        def close_group():
+            if not group:
+                return
+            taken = []
+            for index in group:
+                start = 600 * sum(durations[:index + 1])
+                stop = start + 600 * durations[index + 1]
+                taken.append(samples[start:stop])
+            import numpy as np
+            estimates.append(_spectral_peak(np.concatenate(taken)))
+
+        for index, value in enumerate(pitches):
+            if isinstance(value, float) and (group_hz is None or value == group_hz):
+                group_hz = value
+                group.append(index)
+                continue
+            close_group()
+            group = []
+            group_hz = None
+            if isinstance(value, float):
+                group_hz = value
+                group.append(index)
+        close_group()
+        found = [(target, estimate) for target, estimate in zip(targets, estimates)]
+        self.assertEqual(len(found), 3, (utterances[0].phonemes, pitches, found))
+        for target, estimate in found:
+            self.assertIsNotNone(estimate, (utterances[0].phonemes, found))
+            self.assertLess(abs(estimate - target) / target, 0.05, found)
+
