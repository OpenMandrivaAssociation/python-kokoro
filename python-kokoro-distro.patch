@@ -0,0 +1,138 @@
+"""Fit a phoneme string to one Kokoro checkpoint's alphabet.
+
+Kokoro does not speak general IPA. Each checkpoint has its own symbol
+table (``config.json`` vocab). A symbol that is not in that table is
+replaced with a close match when we have one, otherwise it is dropped.
+Nothing is logged: a missing symbol is not a hard error.
+"""
+
+import unicodedata
+
+# Replacements are the symbols Kokoro was trained with. Checked only after
+# the original character misses the active vocab, so a checkpoint that
+# actually has ʏ keeps ʏ.
+_CLOSE = {
+    'ʏ': 'y',   # espeak short-ü; Kokoro has y, not ʏ
+    'g': 'ɡ',   # ASCII g vs Latin script g U+0261
+    'ɢ': 'ɡ',
+    'ʀ': 'ʁ',
+    'ɝ': 'ɚ',
+    'ä': 'ɛ',
+    'ö': 'ø',
+    'ü': 'y',
+    'ë': 'ə',
+    'ï': 'i',
+    'ÿ': 'y',
+    'ʉ': 'u',
+    'ɵ': 'ø',
+    'ɘ': 'ə',
+    'ɞ': 'ɜ',
+    'ɶ': 'œ',
+    'ʍ': 'w',
+    'ɫ': 'l',
+    'ɱ': 'm',
+    'ʑ': 'ʒ',
+    'ɧ': 'ʃ',
+    'ɦ': 'h',
+    'ħ': 'h',
+    'ʕ': 'ʔ',
+    'ˑ': 'ː',
+    'ʷ': 'w',
+    'ʱ': 'ʰ',
+    "'": 'ˈ',
+}
+
+# Combining marks that are not themselves in the vocab.
+# pre: emit the Kokoro symbol before the base; post: after it.
+_MARKS = {
+    '\u0301': ('ˈ', 'pre'),   # acute ~ primary stress
+    '\u0300': ('ˌ', 'pre'),   # grave ~ secondary stress
+    '\u0304': ('ː', 'post'),  # macron ~ length
+    '\u0329': ('ᵊ', 'pre'),   # syllabic consonant
+}
+
+
+def _from_table(ch, vocab):
+    replacement = _CLOSE.get(ch)
+    if not replacement:
+        return ''
+    return ''.join(part for part in replacement if part in vocab)
+
+
+def _from_marks(ch, vocab):
+    parts = unicodedata.normalize('NFD', ch)
+    if len(parts) <= 1:
+        return ''
+    base = _from_table(parts[0], vocab) if parts[0] not in vocab else parts[0]
+    if not base:
+        return ''
+    pre = []
+    post = []
+    for mark in parts[1:]:
+        if mark in vocab:
+            post.append(mark)
+            continue
+        spec = _MARKS.get(mark)
+        if spec is None or spec[0] not in vocab:
+            continue
+        if spec[1] == 'pre':
+            pre.append(spec[0])
+        else:
+            post.append(spec[0])
+    return ''.join(pre) + base + ''.join(post)
+
+
+# Pitch maps are aligned to phoneme characters. None keeps the model's
+# own pitch. This marker, on a space between two notes, glides from one
+# frequency to the next instead of falling back to speech for that gap.
+PITCH_GLIDE = 'glide'
+
+
+def fit_pitched(phonemes, pitches, vocab):
+    """Fit ``phonemes`` and keep a pitch value on every surviving symbol.
+
+    ``pitches`` is one value per character: a frequency in hertz, None, or
+    :data:`PITCH_GLIDE`. A character that becomes several symbols copies
+    its value. A dropped character drops its value. ``pitches`` of None,
+    or a map that does not line up, fits the text and returns no map.
+    """
+    if not pitches or len(pitches) != len(phonemes or ''):
+        return fit_phonemes(phonemes, vocab), None
+    chars = []
+    kept = []
+    for ch, freq in zip(phonemes, pitches):
+        fitted = fit_phonemes(ch, vocab)
+        if not fitted:
+            continue
+        chars.append(fitted)
+        kept.extend([freq] * len(fitted))
+    return ''.join(chars), kept
+
+
+def fit_phonemes(phonemes, vocab):
+    """Return ``phonemes`` using only symbols in ``vocab``.
+
+    ``vocab`` is the checkpoint's symbol-to-id map. Known symbols pass
+    through. A precomposed character whose decomposed pieces are all known
+    (for example ã) is decomposed. Anything else is a close match from the
+    table above, or it is dropped.
+    """
+    if not phonemes or not vocab:
+        return ''
+    out = []
+    for ch in phonemes:
+        if ch in vocab:
+            out.append(ch)
+            continue
+        decomposed = unicodedata.normalize('NFD', ch)
+        if decomposed != ch and all(part in vocab for part in decomposed):
+            out.append(decomposed)
+            continue
+        mapped = _from_table(ch, vocab)
+        if mapped:
+            out.append(mapped)
+            continue
+        mapped = _from_marks(ch, vocab)
+        if mapped:
+            out.append(mapped)
+    return ''.join(out)
