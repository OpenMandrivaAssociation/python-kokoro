+"""Mixer: one text, several voices, languages, and raw phoneme spans."""
+
+import json
+import unittest
+import wave
+from pathlib import Path
+
+from kokoro.assets import normalize_lang
+from kokoro.model import impose_pitch
+from kokoro.pitch import psola
+from kokoro.phonemes import PITCH_GLIDE, fit_phonemes, fit_pitched
+from kokoro.pipeline import _clip_phonemes
+from kokoro.speak import (
+    chunk_phonemes,
+    chunk_pitched,
+    join_pieces,
+    parse_markup,
+    phonemize,
+    plan_utterances,
+    prepare_speech,
+    resolve_voice,
+    VoiceInfo,
+)
+
+VOCAB = json.load(
+    open('/usr/share/kokoro/models/thorsten/config.json', encoding='utf-8')
+)['vocab']
+ASCII = {chr(code): 1 for code in range(32, 127)}
+
+
+def _identity_vocab(_model):
+    class _All:
+        def __contains__(self, key):
+            return True
+
+        def __bool__(self):
+            return True
+
+    return _All()
+
+
+class FitTests(unittest.TestCase):
+    def test_known_symbols_stay(self):
+        text = 'stˈɑɹ tɹˈɛk'
+        self.assertEqual(fit_phonemes(text, VOCAB), text)
+
+    def test_short_u_becomes_y(self):
+        self.assertEqual(fit_phonemes('fˈʏnf', VOCAB), 'fˈynf')
+
+    def test_ascii_g_becomes_script_g(self):
+        self.assertEqual(fit_phonemes('g', VOCAB), 'ɡ')
+
+    def test_nasal_vowel_decomposes(self):
+        self.assertEqual(fit_phonemes('ã', VOCAB), 'a\u0303')
+
+    def test_german_umlaut_letters(self):
+        self.assertEqual(fit_phonemes('äöü', VOCAB), 'ɛøy')
+
+    def test_acute_becomes_stress(self):
+        self.assertEqual(fit_phonemes('á', VOCAB), 'ˈa')
+
+    def test_unknown_is_dropped(self):
+        self.assertEqual(fit_phonemes('stˈɑɹ☃tɹˈɛk', VOCAB), 'stˈɑɹtɹˈɛk')
+        self.assertNotIn('☃', fit_phonemes('☃', VOCAB))
+
+    def test_pitch_follows_replaced_symbols(self):
+        text, hz = fit_pitched('á☃b', [440.0, 10.0, 20.0], VOCAB)
+        self.assertEqual(text, 'ˈab')
+        self.assertEqual(hz, [440.0, 440.0, 20.0])
+        self.assertEqual(fit_pitched('ab', None, VOCAB), (fit_phonemes('ab', VOCAB), None))
+
+    def test_pipeline_clip_uses_the_same_map(self):
+        class Model:
+            vocab = VOCAB
+
+        self.assertEqual(_clip_phonemes('fˈʏnf ☃', Model()), 'fˈynf ')
+
+
+class ParseTests(unittest.TestCase):
+    def test_plain_text_is_one_span(self):
+        spans = parse_markup('Der Star sang.', 'thorsten', 'd')
+        self.assertEqual(len(spans), 1)
+        self.assertEqual(spans[0].text, 'Der Star sang.')
+        self.assertEqual(spans[0].voice, 'thorsten')
+        self.assertEqual(spans[0].lang, 'd')
+        self.assertFalse(spans[0].raw)
+
+    def test_voice_does_not_change_language(self):
+        spans = parse_markup(
+            'A <voice name="am_adam">B</voice> C',
+            'af_heart',
+            'd',
+        )
+        self.assertEqual(
+            [(s.text, s.voice, s.lang, s.raw) for s in spans],
+            [
+                ('A ', 'af_heart', 'd', False),
+                ('B', 'am_adam', 'd', False),
+                (' C', 'af_heart', 'd', False),
+            ],
+        )
+
+    def test_voice_lang_attribute(self):
